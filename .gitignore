# Running the cicd/ scripts locally leaves bytecode.
__pycache__/
*.pyc

# Local tool caches
.ruff_cache/

# Build output — the dacpac is produced by CI and uploaded as an artifact.
dacpac-out/
global.json

# parameter.yml is copied into the git directory at deploy time, because that
# is where fabric-cicd looks for it. The source of truth is cicd/parameter.yml.
fabric/parameter.yml
